# ==============================================================================
# RozKaam Mobile App - Environment Variables Template (.env.example)
# Copy this file to .env and fill in your actual values.
# NEVER commit your actual .env file with real secrets to GitHub!
# ==============================================================================

# ------------------------------------------------------------------------------
# Firebase Client Configuration (From Firebase Console -> Project Settings)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id_here

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway (Public Key ID ONLY - Never put key_secret in mobile app)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# ------------------------------------------------------------------------------
# Backend API Base URL
# ------------------------------------------------------------------------------
EXPO_PUBLIC_PAYMENT_API_URL=http://localhost:5000
